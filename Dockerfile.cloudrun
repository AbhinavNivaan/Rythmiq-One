# Dockerfile.cloudrun
# Rythmiq One — Cloud Run Worker
#
# Pre-bakes ALL dependencies to eliminate cold-start pip install overhead.
# Designed for Google Cloud Run deployment.
#
# Build:
#   gcloud builds submit --tag asia-south1-docker.pkg.dev/PROJECT/REPO/worker:latest --timeout=1200 -f Dockerfile.cloudrun .
#
# Deploy:
#   gcloud run deploy rythmiq-worker --image asia-south1-docker.pkg.dev/PROJECT/REPO/worker:latest --region asia-south1 ...

FROM python:3.11-slim

# =============================================================================
# System Dependencies
# =============================================================================
# Required for image processing and OCR pipeline
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    ca-certificates \
    libleptonica-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# jbig2enc — optional JBIG2 encoder for full MRC compression.
# Built from source (not in Debian Trixie repos). Forces the AC_CHECK_LIB
# cache variable to skip the broken leptonica detection, then links against
# liblept.so which IS present via libleptonica-dev.
# If compilation fails the worker falls back to JPEG2000 automatically.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git autoconf automake libtool build-essential \
    && git clone --depth 1 --branch 0.29 https://github.com/agl/jbig2enc.git /tmp/jbig2enc \
    && cd /tmp/jbig2enc \
    && sed -i 's/findFileFormatStream/pixCreate/g' configure.ac \
    && ./autogen.sh \
    && LDFLAGS="-L/usr/lib/$(gcc -print-multiarch)" \
       CXXFLAGS="-I/usr/include/leptonica" \
       ac_cv_lib_lept_pixCreate=yes \
       ./configure \
    && make -j"$(nproc)" \
    && make install \
    && echo "jbig2enc installed: $(jbig2 --version 2>&1 | head -1)" \
    || echo "WARNING: jbig2enc build failed; MRC pipeline will use JPEG2000 fallback" \
    ; rm -rf /tmp/jbig2enc \
    && apt-get remove --purge -y git autoconf automake libtool build-essential 2>/dev/null || true \
    && apt-get autoremove -y 2>/dev/null || true \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Python Environment Setup
# =============================================================================
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

# =============================================================================
# Python Dependencies
# =============================================================================
COPY worker/requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir fastapi uvicorn pydantic pydantic-settings

# =============================================================================
# Pre-download ML Models
# =============================================================================
# Bake the rembg U2-Net model (~170 MB) into the image so the first Cloud Run
# request does not stall waiting for a network download.
# The model is stored at /root/.u2net/u2net.onnx inside the container.
RUN python -c "\
from rembg import remove; \
from PIL import Image; \
import io; \
img = Image.new('RGB', (10, 10), color=(128, 128, 128)); \
remove(img); \
print('rembg model pre-download OK'); \
"

# =============================================================================
# Application Code
# =============================================================================
COPY worker/ ./worker/

# =============================================================================
# Cloud Run Configuration
# =============================================================================
# Cloud Run requires listening on PORT env var (default 8080)
ENV PORT=8080
EXPOSE 8080

# =============================================================================
# Health Check
# =============================================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# =============================================================================
# Startup Command
# =============================================================================
CMD ["python", "-u", "worker/server.py"]
