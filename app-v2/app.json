{
  "expo": {
    "name": "Rythmiq",
    "slug": "rythmiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "rythmiq",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rythmiq.one",
      "infoPlist": {
        "NSCameraUsageDescription": "Rythmiq needs camera access to scan your documents",
        "NSPhotoLibraryUsageDescription": "Rythmiq needs photo library access to upload documents",
        "NSFaceIDUsageDescription": "Use Face ID to unlock Rythmiq"
      }
    },
    "android": {
      "package": "app.rythmiq.one",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070712"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-dev-client",
      "react-native-fast-tflite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rythmiq to access your camera to scan documents"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rythmiq to access your photos to upload documents"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "environment": "development",
      "apiBaseUrl": "http://localhost:8000",
      "enableBiometric": true,
      "enableOffline": false,
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
