# ==============================================
# Rythmiq One - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ==============================================

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ==============================================
# DIGITALOCEAN SPACES CONFIGURATION
# ==============================================
# Get these from: https://cloud.digitalocean.com/spaces

DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=rythmiq-documents
DO_SPACES_ACCESS_KEY=your-spaces-access-key
DO_SPACES_SECRET_KEY=your-spaces-secret-key

# ==============================================
# CAMBER EXECUTION BACKEND
# ==============================================
# Get these from: https://camber.dev/dashboard

CAMBER_API_URL=https://api.camber.dev
CAMBER_API_KEY=your-camber-api-key
CAMBER_APP_NAME=rythmiq-worker-python-v2

# Execution backend: 'local' (mock for testing) or 'camber' (production)
EXECUTION_BACKEND=camber

# ==============================================
# SERVICE CONFIGURATION
# ==============================================

# Environment: dev, staging, prod
SERVICE_ENV=dev

# Webhook configuration
WEBHOOK_SECRET=generate-a-secure-random-string
WEBHOOK_BASE_URL=https://api.rythmiq.app

# API port (default 8000)
API_PORT=8000

# ==============================================
# URL EXPIRY SETTINGS
# ==============================================

# Pre-signed URL expiry (in seconds)
UPLOAD_URL_EXPIRY_SECONDS=3600
DOWNLOAD_URL_EXPIRY_SECONDS=3600

# ==============================================
# OPTIONAL: MONITORING (Phase 2)
# ==============================================

# SENTRY_DSN=https://xxx@sentry.io/xxx
# ANALYTICS_KEY=your-analytics-key
