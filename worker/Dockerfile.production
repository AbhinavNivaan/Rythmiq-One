# =============================================================================
# Rythmiq Worker - Production Dockerfile
# =============================================================================
# 
# Production image with ALL Python dependencies pre-installed.
# Zero runtime pip installs.
#
# Target: linux/amd64 ONLY
# Base: python:3.11-slim-bookworm
# Entrypoint: Cloud Run HTTP server (uvicorn server:app)
#
# Build:
#   docker buildx build \
#     --platform linux/amd64 \
#     --load \
#     -f worker/Dockerfile.production \
#     -t rythmiq/worker:production \
#     ./worker
#
# Run:
#   docker run --rm -p 8080:8080 \
#     -e SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com \
#     -e SPACES_REGION=sgp1 \
#     -e SPACES_BUCKET=rythmiq-one-artifacts \
#     -e SPACES_KEY=... \
#     -e SPACES_SECRET=... \
#     rythmiq/worker:production
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Base with system dependencies
# -----------------------------------------------------------------------------
FROM --platform=linux/amd64 python:3.11-slim-bookworm AS base

# Prevent Python from writing pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install ONLY required system dependencies for OpenCV + Paddle + SSL
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenCV headless requirements
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    # Image format codecs
    libjpeg62-turbo \
    libpng16-16 \
    libtiff6 \
    libwebp7 \
    # SSL/TLS for boto3
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# -----------------------------------------------------------------------------
# Stage 2: Builder - Install Python packages
# -----------------------------------------------------------------------------
FROM base AS builder

# Build tools for compiling native extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create venv
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy pinned requirements
COPY requirements-pinned.txt /tmp/requirements.txt

# Install Python packages - no cache, no upgrade checks
RUN pip install --upgrade pip setuptools wheel \
    && pip install -r /tmp/requirements.txt \
    && find /opt/venv -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/venv -type f -name "*.pyc" -delete 2>/dev/null || true \
    && find /opt/venv -type f -name "*.pyo" -delete 2>/dev/null || true

# -----------------------------------------------------------------------------
# Stage 3: Runtime - Minimal production image
# -----------------------------------------------------------------------------
FROM base AS runtime

# Create non-root user
RUN useradd --create-home --shell /bin/bash --uid 1000 worker

# Copy venv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Working directory
WORKDIR /app

# Copy worker source code
COPY --chown=worker:worker . /app/

# Ensure Python path includes app directory
ENV PYTHONPATH=/app

# Switch to non-root user
USER worker

# Verify installation at build time
RUN python -c "\
import sys; \
print(f'Python: {sys.version}'); \
import boto3; print(f'boto3: {boto3.__version__}'); \
import cv2; print(f'opencv: {cv2.__version__}'); \
import numpy; print(f'numpy: {numpy.__version__}'); \
import PIL; print(f'pillow: {PIL.__version__}'); \
import httpx; print(f'httpx: {httpx.__version__}'); \
print('All imports successful'); \
"

# Cloud Run HTTP server entrypoint
ENTRYPOINT ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
