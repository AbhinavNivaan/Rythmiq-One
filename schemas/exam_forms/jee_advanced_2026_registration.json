{
  "schema_id": "jee_advanced_2026_registration",
  "schema_type": "exam_form",
  "schema_version": "1.0.0",
  "status": "active",
  "metadata": {
    "display_name": "JEE Advanced 2026 Registration Form",
    "short_name": "JEE Advanced 2026",
    "conducting_body": "IIT Council",
    "official_website": "https://jeeadv.ac.in",
    "category": "engineering_entrance",
    "applicable_year": 2026,
    "country": "IN",
    "language": "en"
  },
  "key_dates": {
    "registration_opens": "2026-04-20",
    "registration_closes": "2026-05-02",
    "correction_window_start": "2026-05-03",
    "correction_window_end": "2026-05-05",
    "exam_date": "2026-05-24"
  },
  "form_sections": [
    {
      "section_id": "candidate_profile",
      "title": "Candidate Profile",
      "order": 1,
      "fields": [
        { "field_id": "full_name", "label": "Full Name", "type": "string", "required": true },
        { "field_id": "date_of_birth", "label": "Date of Birth", "type": "date", "required": true, "validation": { "format": "DD/MM/YYYY" } },
        { "field_id": "gender", "label": "Gender", "type": "enum", "required": true, "enum_values": ["Male", "Female", "Third Gender"] },
        { "field_id": "category", "label": "Category", "type": "enum", "required": true, "enum_values": ["General", "GEN-EWS", "OBC-NCL", "SC", "ST"] },
        { "field_id": "pwd_status", "label": "PwD Status", "type": "boolean", "required": true }
      ]
    },
    {
      "section_id": "jee_main_and_contact",
      "title": "JEE Main and Contact",
      "order": 2,
      "fields": [
        { "field_id": "jee_main_application_no", "label": "JEE Main Application Number", "type": "string", "required": true },
        { "field_id": "jee_main_roll_no", "label": "JEE Main Roll Number", "type": "string", "required": true },
        { "field_id": "mobile_number", "label": "Mobile Number", "type": "string", "required": true, "verification": "OTP", "validation": { "pattern": "^[6-9][0-9]{9}$" } },
        { "field_id": "email_id", "label": "Email ID", "type": "string", "required": true, "verification": "OTP", "validation": { "format": "email" } }
      ]
    },
    {
      "section_id": "exam_preferences",
      "title": "Exam Preferences",
      "order": 3,
      "fields": [
        { "field_id": "scribe_opted", "label": "Scribe Required", "type": "boolean", "required": true },
        { "field_id": "exam_zone", "label": "Exam Zone", "type": "enum", "required": true, "enum_values": ["Zone 1", "Zone 2", "Zone 3", "Zone 4", "Zone 5", "Zone 6", "Zone 7"] },
        { "field_id": "question_paper_medium", "label": "Question Paper Medium", "type": "enum", "required": true, "enum_values": ["English", "Hindi"] }
      ]
    }
  ],
  "document_uploads": [
    {
      "doc_id": "photograph_passport",
      "label": "Passport-size Photograph",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 10,
      "size_max_kb": 300,
      "required": true,
      "required_if": null,
      "document_category": "photograph",
      "document_subtype": "Passport Photo"
    },
    {
      "doc_id": "signature",
      "label": "Signature",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 4,
      "size_max_kb": 50,
      "required": true,
      "required_if": null,
      "document_category": "signature",
      "document_subtype": "Personal Signature"
    },
    {
      "doc_id": "class_12_certificate",
      "label": "Class 12 Certificate",
      "allowed_formats": ["PDF"],
      "size_min_kb": 50,
      "size_max_kb": 500,
      "required": true,
      "required_if": null,
      "document_category": "academic",
      "document_subtype": "Class 12 Certificate",
      "seeds_document_subtypes": ["Class 12 Certificate"]
    },
    {
      "doc_id": "category_certificate",
      "label": "Category Certificate",
      "allowed_formats": ["PDF"],
      "size_min_kb": 50,
      "size_max_kb": 500,
      "required": false,
      "required_if": "pwd_status == true",
      "document_category": "certificate",
      "document_subtype": "PwD Certificate",
      "seeds_document_subtypes": ["PwD Certificate"]
    },
    {
      "doc_id": "scribe_documents",
      "label": "Scribe Documents",
      "allowed_formats": ["PDF"],
      "size_min_kb": 50,
      "size_max_kb": 500,
      "required": false,
      "required_if": "scribe_opted == true",
      "document_category": "other",
      "document_subtype": "Scribe Document",
      "seeds_document_subtypes": ["Scribe Document"]
    }
  ],
  "fee_structure": {
    "currency": "INR",
    "payment_modes": ["UPI", "Net Banking", "Credit Card", "Debit Card"],
    "tiers": [
      { "category": "General", "amount": 3200 },
      { "category": "GEN-EWS", "amount": 3200 },
      { "category": "OBC-NCL", "amount": 3200 },
      { "category": "SC", "amount": 1600 },
      { "category": "ST", "amount": 1600 },
      { "category": "PwD", "amount": 1600 }
    ]
  }
}