{
  "schema_id": "rrb_ntpc_2026_registration",
  "schema_type": "exam_form",
  "schema_version": "1.0.0",
  "status": "active",
  "metadata": {
    "display_name": "RRB NTPC 2026 Registration Form",
    "short_name": "RRB NTPC 2026",
    "conducting_body": "Railway Recruitment Boards",
    "official_website": "https://www.rrbcdg.gov.in",
    "category": "other_exam",
    "applicable_year": 2026,
    "country": "IN",
    "language": "en"
  },
  "key_dates": {
    "registration_opens": "2026-05-20",
    "registration_closes": "2026-06-20",
    "correction_window_start": "2026-06-23",
    "correction_window_end": "2026-06-25",
    "exam_date": "2026-09-18"
  },
  "form_sections": [
    {
      "section_id": "personal_details",
      "title": "Personal Details",
      "order": 1,
      "fields": [
        { "field_id": "full_name", "label": "Full Name", "type": "string", "required": true },
        { "field_id": "date_of_birth", "label": "Date of Birth", "type": "date", "required": true, "validation": { "format": "DD/MM/YYYY" } },
        { "field_id": "gender", "label": "Gender", "type": "enum", "required": true, "enum_values": ["Male", "Female", "Transgender"] },
        { "field_id": "category", "label": "Category", "type": "enum", "required": true, "enum_values": ["General", "OBC", "SC", "ST", "EWS"] },
        { "field_id": "pwd_status", "label": "PwBD Status", "type": "boolean", "required": true }
      ]
    },
    {
      "section_id": "contact_details",
      "title": "Contact Details",
      "order": 2,
      "fields": [
        { "field_id": "mobile_number", "label": "Mobile Number", "type": "string", "required": true, "verification": "OTP", "validation": { "pattern": "^[6-9][0-9]{9}$" } },
        { "field_id": "email_id", "label": "Email ID", "type": "string", "required": true, "verification": "OTP", "validation": { "format": "email" } },
        { "field_id": "railway_zone_preference", "label": "Railway Zone Preference", "type": "array", "required": true }
      ]
    },
    {
      "section_id": "education_and_posts",
      "title": "Education and Post Preferences",
      "order": 3,
      "fields": [
        { "field_id": "education_level", "label": "Education Level", "type": "enum", "required": true, "enum_values": ["12th Pass", "Graduate"] },
        { "field_id": "typing_skill", "label": "Typing Skill", "type": "boolean", "required": true },
        { "field_id": "post_preferences", "label": "Post Preferences", "type": "array", "required": true },
        { "field_id": "exam_language", "label": "Exam Language", "type": "enum", "required": true, "enum_values": ["English", "Hindi"] }
      ]
    }
  ],
  "document_uploads": [
    {
      "doc_id": "photograph_passport",
      "label": "Photograph",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 20,
      "size_max_kb": 200,
      "required": true,
      "required_if": null,
      "document_category": "photograph",
      "document_subtype": "Passport Photo"
    },
    {
      "doc_id": "signature",
      "label": "Signature",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 10,
      "size_max_kb": 100,
      "required": true,
      "required_if": null,
      "document_category": "signature",
      "document_subtype": "Personal Signature"
    },
    {
      "doc_id": "sc_st_certificate",
      "label": "SC/ST Certificate",
      "allowed_formats": ["PDF"],
      "size_min_kb": 50,
      "size_max_kb": 500,
      "required": false,
      "required_if": null,
      "document_category": "certificate",
      "document_subtype": "Caste Certificate",
      "seeds_document_subtypes": ["Caste Certificate"]
    }
  ],
  "fee_structure": {
    "currency": "INR",
    "payment_modes": ["UPI", "Net Banking", "Credit Card", "Debit Card"],
    "tiers": [
      { "category": "General", "amount": 500 },
      { "category": "OBC", "amount": 500 },
      { "category": "SC", "amount": 250 },
      { "category": "ST", "amount": 250 },
      { "category": "PwBD", "amount": 250 },
      { "category": "Women", "amount": 250 }
    ]
  }
}