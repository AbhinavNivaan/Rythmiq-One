{
  "schema_id": "clat_ug_2026_registration",
  "schema_type": "exam_form",
  "schema_version": "1.0.0",
  "status": "active",
  "metadata": {
    "display_name": "CLAT UG 2026 Registration Form",
    "short_name": "CLAT UG 2026",
    "conducting_body": "Consortium of NLUs",
    "official_website": "https://consortiumofnlus.ac.in",
    "category": "law_entrance",
    "applicable_year": 2026,
    "country": "IN",
    "language": "en"
  },
  "key_dates": {
    "registration_opens": "2026-07-15",
    "registration_closes": "2026-10-20",
    "correction_window_start": "2026-10-23",
    "correction_window_end": "2026-10-25",
    "exam_date": "2026-12-07"
  },
  "form_sections": [
    {
      "section_id": "candidate_identity",
      "title": "Candidate Identity",
      "order": 1,
      "fields": [
        { "field_id": "full_name", "label": "Full Name", "type": "string", "required": true },
        { "field_id": "date_of_birth", "label": "Date of Birth", "type": "date", "required": true, "validation": { "format": "DD/MM/YYYY" } },
        { "field_id": "gender", "label": "Gender", "type": "enum", "required": true, "enum_values": ["Male", "Female", "Transgender"] },
        { "field_id": "category", "label": "Category", "type": "enum", "required": true, "enum_values": ["General", "OBC", "SC", "ST", "EWS"] },
        { "field_id": "pwd_status", "label": "PwD Status", "type": "boolean", "required": true }
      ]
    },
    {
      "section_id": "communication_and_reservation",
      "title": "Communication and Reservation",
      "order": 2,
      "fields": [
        { "field_id": "mobile_number", "label": "Mobile Number", "type": "string", "required": true, "verification": "OTP", "validation": { "pattern": "^[6-9][0-9]{9}$" } },
        { "field_id": "email_id", "label": "Email ID", "type": "string", "required": true, "verification": "OTP", "validation": { "format": "email" } },
        { "field_id": "domicile_state", "label": "Domicile State", "type": "string", "required": true }
      ]
    },
    {
      "section_id": "education_and_preferences",
      "title": "Education and NLU Preferences",
      "order": 3,
      "fields": [
        { "field_id": "class_12_status", "label": "Class 12 Status", "type": "enum", "required": true, "enum_values": ["Appearing", "Passed"] },
        { "field_id": "nlu_preferences", "label": "NLU Preferences", "type": "array", "required": true },
        { "field_id": "exam_city_preference_1", "label": "Exam City Preference 1", "type": "string", "required": true },
        { "field_id": "exam_city_preference_2", "label": "Exam City Preference 2", "type": "string", "required": true }
      ]
    }
  ],
  "document_uploads": [
    {
      "doc_id": "photograph_passport",
      "label": "Photograph",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 10,
      "size_max_kb": 500,
      "required": true,
      "required_if": null,
      "document_category": "photograph",
      "document_subtype": "Passport Photo"
    },
    {
      "doc_id": "signature",
      "label": "Signature",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 10,
      "size_max_kb": 100,
      "required": true,
      "required_if": null,
      "document_category": "signature",
      "document_subtype": "Personal Signature"
    },
    {
      "doc_id": "domicile_certificate",
      "label": "Domicile Certificate",
      "allowed_formats": ["PDF"],
      "size_min_kb": 50,
      "size_max_kb": 500,
      "required": false,
      "required_if": null,
      "document_category": "certificate",
      "document_subtype": "Domicile Certificate",
      "seeds_document_subtypes": ["Domicile Certificate"]
    }
  ],
  "fee_structure": {
    "currency": "INR",
    "payment_modes": ["UPI", "Net Banking", "Credit Card", "Debit Card"],
    "tiers": [
      { "category": "General", "amount": 4000 },
      { "category": "OBC", "amount": 4000 },
      { "category": "SC", "amount": 3500 },
      { "category": "ST", "amount": 3500 },
      { "category": "PwD", "amount": 3500 }
    ]
  }
}