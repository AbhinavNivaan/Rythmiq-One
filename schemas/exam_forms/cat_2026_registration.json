{
  "schema_id": "cat_2026_registration",
  "schema_type": "exam_form",
  "schema_version": "1.0.0",
  "status": "active",
  "metadata": {
    "display_name": "CAT 2026 Registration Form",
    "short_name": "CAT 2026",
    "conducting_body": "Indian Institutes of Management",
    "official_website": "https://iimcat.ac.in",
    "category": "management_entrance",
    "applicable_year": 2026,
    "country": "IN",
    "language": "en"
  },
  "key_dates": {
    "registration_opens": "2026-08-01",
    "registration_closes": "2026-09-21",
    "correction_window_start": "2026-09-25",
    "correction_window_end": "2026-09-28",
    "exam_date": "2026-11-29"
  },
  "form_sections": [
    {
      "section_id": "personal_profile",
      "title": "Personal Profile",
      "order": 1,
      "fields": [
        { "field_id": "full_name", "label": "Full Name", "type": "string", "required": true },
        { "field_id": "date_of_birth", "label": "Date of Birth", "type": "date", "required": true, "validation": { "format": "DD/MM/YYYY" } },
        { "field_id": "gender", "label": "Gender", "type": "enum", "required": true, "enum_values": ["Male", "Female", "Transgender"] },
        { "field_id": "category", "label": "Category", "type": "enum", "required": true, "enum_values": ["General", "NC-OBC", "SC", "ST", "EWS"] },
        { "field_id": "pwd_status", "label": "PwD Status", "type": "boolean", "required": true }
      ]
    },
    {
      "section_id": "contact_profile",
      "title": "Contact Profile",
      "order": 2,
      "fields": [
        { "field_id": "mobile_number", "label": "Mobile Number", "type": "string", "required": true, "verification": "OTP", "validation": { "pattern": "^[6-9][0-9]{9}$" } },
        { "field_id": "email_id", "label": "Email ID", "type": "string", "required": true, "verification": "OTP", "validation": { "format": "email" } },
        { "field_id": "city", "label": "City", "type": "string", "required": true }
      ]
    },
    {
      "section_id": "academic_and_test_city",
      "title": "Academic and Test City",
      "order": 3,
      "fields": [
        { "field_id": "graduation_percentage", "label": "Graduation Percentage", "type": "integer", "required": true, "validation": { "minimum": 0, "maximum": 100 } },
        { "field_id": "work_experience_months", "label": "Work Experience (Months)", "type": "integer", "required": true, "validation": { "minimum": 0 } },
        { "field_id": "test_city_1", "label": "Test City Preference 1", "type": "string", "required": true },
        { "field_id": "test_city_2", "label": "Test City Preference 2", "type": "string", "required": true }
      ]
    }
  ],
  "document_uploads": [
    {
      "doc_id": "photograph_passport",
      "label": "Photograph",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 10,
      "size_max_kb": 200,
      "required": true,
      "required_if": null,
      "document_category": "photograph",
      "document_subtype": "Passport Photo"
    },
    {
      "doc_id": "signature",
      "label": "Signature",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 10,
      "size_max_kb": 80,
      "required": true,
      "required_if": null,
      "document_category": "signature",
      "document_subtype": "Personal Signature"
    },
    {
      "doc_id": "category_certificate",
      "label": "Category Certificate",
      "allowed_formats": ["PDF"],
      "size_min_kb": 50,
      "size_max_kb": 500,
      "required": false,
      "required_if": "pwd_status == true",
      "document_category": "certificate",
      "document_subtype": "PwD Certificate",
      "seeds_document_subtypes": ["PwD Certificate"]
    }
  ],
  "fee_structure": {
    "currency": "INR",
    "payment_modes": ["UPI", "Net Banking", "Credit Card", "Debit Card"],
    "tiers": [
      { "category": "General", "amount": 2500 },
      { "category": "NC-OBC", "amount": 2500 },
      { "category": "SC", "amount": 1250 },
      { "category": "ST", "amount": 1250 },
      { "category": "PwD", "amount": 1250 }
    ]
  }
}