{
  "schema_id": "ssc_cgl_2026_registration",
  "schema_type": "exam_form",
  "schema_version": "1.0.0",
  "status": "active",
  "metadata": {
    "display_name": "SSC CGL 2026 Registration Form",
    "short_name": "SSC CGL 2026",
    "conducting_body": "Staff Selection Commission",
    "official_website": "https://ssc.gov.in",
    "category": "other_exam",
    "applicable_year": 2026,
    "country": "IN",
    "language": "en"
  },
  "key_dates": {
    "registration_opens": "2026-06-15",
    "registration_closes": "2026-07-15",
    "correction_window_start": "2026-07-18",
    "correction_window_end": "2026-07-20",
    "exam_date": "2026-09-08"
  },
  "form_sections": [
    {
      "section_id": "applicant_details",
      "title": "Applicant Details",
      "order": 1,
      "fields": [
        { "field_id": "full_name", "label": "Full Name", "type": "string", "required": true },
        { "field_id": "date_of_birth", "label": "Date of Birth", "type": "date", "required": true, "validation": { "format": "DD/MM/YYYY" } },
        { "field_id": "gender", "label": "Gender", "type": "enum", "required": true, "enum_values": ["Male", "Female", "Transgender"] },
        { "field_id": "category", "label": "Category", "type": "enum", "required": true, "enum_values": ["General", "OBC", "SC", "ST", "EWS"] },
        { "field_id": "pwd_status", "label": "PwD Status", "type": "boolean", "required": true }
      ]
    },
    {
      "section_id": "communication_details",
      "title": "Communication Details",
      "order": 2,
      "fields": [
        { "field_id": "mobile_number", "label": "Mobile Number", "type": "string", "required": true, "verification": "OTP", "validation": { "pattern": "^[6-9][0-9]{9}$" } },
        { "field_id": "email_id", "label": "Email ID", "type": "string", "required": true, "verification": "OTP", "validation": { "format": "email" } },
        { "field_id": "state", "label": "State", "type": "string", "required": true }
      ]
    },
    {
      "section_id": "education_and_posts",
      "title": "Education and Post Preferences",
      "order": 3,
      "fields": [
        { "field_id": "graduation_status", "label": "Graduation Status", "type": "enum", "required": true, "enum_values": ["Final Year", "Graduate"] },
        { "field_id": "graduation", "label": "Graduation Details", "type": "object", "required": true, "fields": [
          { "field_id": "university_name", "label": "University Name", "type": "string", "required": true },
          { "field_id": "degree", "label": "Degree", "type": "string", "required": true },
          { "field_id": "year_of_passing", "label": "Year of Passing", "type": "integer", "required": true }
        ] },
        { "field_id": "post_preferences", "label": "Post Preferences", "type": "array", "required": true }
      ]
    }
  ],
  "document_uploads": [
    {
      "doc_id": "photograph_passport",
      "label": "Photograph",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 20,
      "size_max_kb": 200,
      "required": true,
      "required_if": null,
      "document_category": "photograph",
      "document_subtype": "Passport Photo"
    },
    {
      "doc_id": "signature",
      "label": "Signature",
      "allowed_formats": ["JPG", "JPEG"],
      "size_min_kb": 10,
      "size_max_kb": 100,
      "required": true,
      "required_if": null,
      "document_category": "signature",
      "document_subtype": "Personal Signature"
    },
    {
      "doc_id": "identity_proof",
      "label": "Identity Proof",
      "allowed_formats": ["PDF", "JPG", "JPEG"],
      "size_min_kb": 50,
      "size_max_kb": 500,
      "required": true,
      "required_if": null,
      "document_category": "identity",
      "document_subtype": "Aadhaar Card"
    },
    {
      "doc_id": "category_certificate",
      "label": "Category Certificate",
      "allowed_formats": ["PDF"],
      "size_min_kb": 50,
      "size_max_kb": 500,
      "required": false,
      "required_if": "pwd_status == true",
      "document_category": "certificate",
      "document_subtype": "PwD Certificate",
      "seeds_document_subtypes": ["PwD Certificate"]
    }
  ],
  "fee_structure": {
    "currency": "INR",
    "payment_modes": ["UPI", "Net Banking", "Credit Card", "Debit Card"],
    "tiers": [
      { "category": "General", "amount": 100 },
      { "category": "OBC", "amount": 100 },
      { "category": "SC", "amount": 0 },
      { "category": "ST", "amount": 0 },
      { "category": "PwD", "amount": 0 },
      { "category": "Women", "amount": 0 }
    ]
  }
}